{
  "name": "todo-shopping",
  "version": "1.0.0",
  "author": "alex99ka (forked from Hamza Hamidi's todo-list)",
  "homepage": "https://alex-todo-shopping.web.app",
  "description": "Todo and shopping lists with households, synced through Firebase, with a recipe-book import",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex99ka/todo-shopping.git"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "sync": "cap sync",
    "emulators": "firebase emulators:start --only firestore,storage,auth",
    "test:rules": "firebase emulators:exec --project demo-todo-list --only firestore,storage \"node --test --test-concurrency=1 'test/rules/**/*.test.ts'\"",
    "test:services": "firebase emulators:exec --project demo-todo-list --only firestore,storage \"node --test --test-concurrency=1 'test/services/**/*.test.ts'\""
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-updater": "^8.52.1",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@ionic/angular": "9.0.4",
    "@ionic/pwa-elements": "3.4.0",
    "firebase": "12.19.0",
    "ionicons": "8.1.0",
    "rxfire": "6.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "firebase-tools": "15.30.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
